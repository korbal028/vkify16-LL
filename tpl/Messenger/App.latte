{extends "../@layout.latte"}

{var $User          = openvk\Web\Models\Entities\User::class}
{var $isClub        = !($correspondent instanceof $User)}
{var $isSelf        = !$isClub && $correspondent->getId() === $thisUser->getId()}
{var $peerSel       = $isClub ? -$correspondent->getId() : $correspondent->getId()}
{var $peerName      = $isSelf ? tr('saved_messages') : $correspondent->getCanonicalName()}
{var $peerFirstName = $isClub ? $correspondent->getCanonicalName() : $correspondent->getFirstName()}
{var $canWrite      = $isSelf || $correspondent->getPrivacyPermission('messages.write', $thisUser)}
{var $peerOnline    = !$isClub && !$isSelf && $correspondent->isOnline()}
{var $imWide        = ($_COOKIE['vkify16_im_wide'] ?? '0') === '1'}
{var $imSide        = (int) ($_COOKIE['vkify16_im_side'] ?? 0)}

{block title}{$peerName}{/block}

{block content}
    {var $imCorresps = iterator_to_array((new openvk\Web\Models\Repositories\Messages)->getCorrespondencies($thisUser, 1))}
    {var $imSettings = (new openvk\Web\Models\Repositories\MessengerDialogs)->getAllFor($thisUser)}
    <div n:class="im-layout, im-layout_chat, $imWide ? im-layout_wide, $imSide > 0 && $imSide < 160 ? im-layout_compact" n:attr="style => $imSide >= 160 ? '--im-side-width: ' . min($imSide, 600) . 'px'">
        <div class="im-layout--side">
            {include "dialogs.latte", corresps => $imCorresps, dialogSettings => $imSettings, isArchive => false, activeSel => $peerSel, thisUser => $thisUser, imWide => $imWide}
        </div>
        <div class="im-layout--main">
            {include imChat}
        </div>
        <div class="im-layout--tabs nomobile">
            <div class="page_block ui_rmenu im-peer-tabs">
                <a class="ui_rmenu_item" href="/im"><span>{_my_messages}</span></a>
                <a class="ui_rmenu_item" href="/im/archive"><span>{_messenger_archive}</span></a>
                <div class="ui_rmenu_sep"></div>
                <div class="im-peer-tabs--foot">
                    {include "wide_toggle.latte", imWide => $imWide}
                </div>
            </div>
        </div>
    </div>

    <template id="msg-attachments-tpl">
        <div data-bind="foreach: attachments" class="im-mess--attachments">
            <div class="msg-attach-j">
                <div data-bind="if: type === 'sticker'" class="msg-attach-j-sticker">
                    <a class="msg-sticker" data-bind="attr: { 'data-pack': sticker.pack, title: sticker.emoji }"><img data-bind="attr: { src: sticker.url, alt: sticker.emoji }" /></a>
                </div>
                <div data-bind="if: type === 'photo'" class="msg-attach-j-photo">
                    <a data-bind="attr: { href: link, 'data-photo-id': id }" class="photoMessengerOpen">
                        <img data-bind="attr: { src: photo.url, alt: photo.caption }" />
                    </a>
                </div>
                <div data-bind="if: type === 'video'" class="msg-attach-j-video">
                    <div class="msg-attach-j-video-player">
                        <div class="bsdn media" data-bind="attr: { 'data-name': video.name, 'data-author': video.author }">
                            <video class="media" data-bind="attr: { src: video.url }"></video>
                        </div>
                    </div>
                    <div class="video-wowzer">
                        <a data-bind="attr: { href: link, 'data-video-id': id }, text: video.name" class="videoMessengerOpen"></a>
                        <span class="video-wowzer-length" data-bind="text: '(' + video.formatted_length + ')'"></span>
                    </div>
                </div>
                <div data-bind="if: type === 'audio'" class="msg-attach-j-audio">
                    <div data-bind="html: html"></div>
                </div>
                <div data-bind="if: type === 'note'" class="msg-attach-j-note">
                    <div data-bind="attr: { 'data-att-type': 'note', 'data-att-id': id }">
                        <div class="attachment_note">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 10"><polygon points="0 0 0 10 8 10 8 4 4 4 4 0 0 0"/><polygon points="5 0 5 3 8 3 5 0"/></svg>
                            <div class="attachment_note_content">
                                <span class="attachment_note_text">{_note}</span>
                                <span class="attachment_note_name">
                                    <a href="#" data-bind="click: function() { showArticle(id); return false; }, text: note.name"></a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-bind="if: type === 'doc'" class="msg-attach-j-doc attachment">
                    <div>
                        <a data-bind="attr: { href: link, 'data-att-type': 'doc', 'data-att-id': id }" style="display:none" class="docGalleryItem viewerOpener"></a>

                        <a class="docMainItem viewerOpener docGalleryItem"
                           data-bind="visible: document.preview && document.preview.medium, attr: { href: link, 'data-id': id }">
                            <img class="docGalleryItem_main_preview" loading="lazy"
                                 data-bind="attr: { src: (document.preview && document.preview.medium) ? document.preview.medium : '', alt: document.name }">
                            <div class="doc_top_panel doc_shown_by_hover">
                                <div class="doc_volume_action" id="add_icon"></div>
                            </div>
                            <div class="doc_bottom_panel doc_shown_by_hover doc_content info_shown">
                                <span class="doc_bottom_panel_name noOverflow doc_name" data-bind="text: document.name"></span>
                                <span class="doc_bottom_panel_size" data-bind="text: document.size_str"></span>
                            </div>
                        </a>

                        <div class="docMainItem docListViewItem"
                             data-bind="visible: !(document.preview && document.preview.medium), attr: { 'data-id': id }">
                            <a class="viewerOpener" data-bind="attr: { href: link }">
                                <img class="doc_icon" data-bind="visible: document.preview && document.preview.tiny, attr: { src: (document.preview && document.preview.tiny) ? document.preview.tiny : '' }">
                                <div class="doc_icon no_image" data-bind="visible: !document.preview">
                                    <span data-bind="text: document.ext"></span>
                                </div>
                            </a>
                            <div class="doc_content noOverflow">
                                <a class="viewerOpener noOverflow" data-bind="attr: { href: link }">
                                    <b class="noOverflow doc_name" data-bind="text: document.name"></b>
                                </a>
                                <div class="doc_content_info">
                                    <span data-bind="text: document.pub_time"></span>, <span data-bind="text: document.size_str"></span>
                                </div>
                            </div>
                            <div class="doc_volume">
                                <div id="add_icon"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="msg-fwd-tpl">
        <div class="im-fwd">
            <div class="im-fwd--head">
                <a class="im-fwd--ava" data-bind="attr: { href: sender.link }"><img data-bind="attr: { src: sender.avatar, alt: sender.name }" /></a>
                <div class="im-fwd--info">
                    <a class="im-fwd--author" data-bind="attr: { href: sender.link }, text: sender.name"></a>
                    <div class="im-fwd--date" data-bind="text: window.msgFullDate(timing.ts)"></div>
                </div>
            </div>
            <div class="im-fwd--text" data-bind="html: text"></div>
            <!-- ko template: 'msg-attachments-tpl' --><!-- /ko -->
            <!-- ko if: fwd && fwd.length -->
            <div class="im-fwd--list" data-bind="template: { name: 'msg-fwd-tpl', foreach: fwd }"></div>
            <!-- /ko -->
        </div>
    </template>

    {script "js/node_modules/knockout/build/output/knockout-latest.js"}
    <script>
        // страница может прийти через ajax-переход, поэтому всё внутри своей области видимости
        (() => {
            const PEER_ID   = {$peerSel};
            const IS_SELF   = {$isSelf};
            const CSRF      = {$csrfToken};
            const API_BASE  = "/im/api/messages" + PEER_ID;
            const SAVED_AVATAR = "/assets/packages/static/openvk/img/im/saved_messages.png";
            window.MSG_ME   = {$thisUser->getId()};

            window.MSG_STR = {
                pin:          {tr("messenger_pin_message")},
                unpin:        {tr("messenger_unpin_message")},
                reply:        {tr("messenger_reply")},
                forward:      {tr("messenger_forward")},
                delete:       {tr("messenger_delete")},
                noText:       {tr("messenger_no_text")},
                saved:        {tr("saved_messages")},
                forwardTo:    {tr("messenger_forward_to")},
                noDialogs:    {tr("no_messages")},
                fwdCount:     {tr("messenger_forwarded_count", "%COUNT%")},
                selected:     {tr("messenger_selected_count", "%COUNT%")},
                cancel:       {tr("cancel")},
                deleteTitle:  {tr("messenger_delete_messages_title")},
                deleteText:   {tr("messenger_delete_messages_confirm", "%COUNT%")},
                deleteForAll: {tr("messenger_delete_for_all")},
                error:        {tr("messages_error_1")},
                errorText:    {tr("messages_error_1_description")},
            };

            window.fwdCountLabel = count => window.MSG_STR.fwdCount.replace("%COUNT%", count);

            // текст сообщения без разметки, для превью над полем ввода
            window.plainText = html => new DOMParser().parseFromString(html || "", "text/html").body.textContent.trim();

            // группировка сообщений подряд от одного отправителя
            const MSG_GROUP_INTERVAL = 10 * 60;
            window.isMsgGrouped = index => {
                const msgs = window.messages();
                if(index < 1 || index >= msgs.length) return false;

                const prev = msgs[index - 1], cur = msgs[index];
                if(prev.sender.id !== cur.sender.id) return false;
                if(typeof prev.timing.ts !== "number" || typeof cur.timing.ts !== "number") return false;
                if(window.isMsgNewDay(index)) return false;

                return (cur.timing.ts - prev.timing.ts) < MSG_GROUP_INTERVAL;
            };

            // у сообщения время, а дата — в разделителе дней и плашке сверху
            const MSG_LOCALE = {getLanguage()}.split(/[_-]/)[0];
            window.msgDay = ts => {
                const d    = new Date(ts * 1000);
                const opts = { day: "numeric", month: "long" };
                if(d.getFullYear() !== new Date().getFullYear()) opts.year = "numeric";

                try {
                    return d.toLocaleDateString(MSG_LOCALE, opts);
                } catch(e) {
                    return d.toLocaleDateString(undefined, opts);
                }
            };

            // у неотправленного превью в sent лежит крутилка
            window.msgTime = msg => (typeof msg.timing.ts === "number" && msg._tuid === undefined)
                ? new Date(msg.timing.ts * 1000).toTimeString().slice(0, 5)
                : msg.timing.sent;

            window.msgFullDate = ts => window.msgDay(ts) + ", " + new Date(ts * 1000).toTimeString().slice(0, 5);

            window.isMsgNewDay = index => {
                const msgs = window.messages();
                const cur  = msgs[index];
                if(!cur || typeof cur.timing.ts !== "number") return false;

                for(let i = index - 1; i > -1; i--) {
                    if(typeof msgs[i].timing.ts !== "number") continue;

                    return new Date(msgs[i].timing.ts * 1000).toDateString() !== new Date(cur.timing.ts * 1000).toDateString();
                }

                return true;
            };

            // плеер из шаблона движка приводим к разметке темы
            const normalizeAudio = root => root.querySelectorAll(".msg-attach-j-audio .selectableTrack").forEach(track => {
                if(track.querySelector(":scope > .selectableTrackRail")) return;

                const load   = track.querySelector(".selectableTrackLoadProgress");
                const rail   = Object.assign(document.createElement("div"), { className: "selectableTrackRail" });
                const played = Object.assign(document.createElement("div"), { className: "selectableTrackPlayed" });
                const slider = Object.assign(document.createElement("div"), { className: "slider" });
                track.replaceChildren(...[rail, load, played, slider].filter(Boolean));
            });

            function MessengerViewModel() {
                window.messages     = ko.observableArray([]);
                window.selectedMsgs = ko.observableArray([]);
                window.pinnedMsg    = ko.observable(null);
                window.replyTo      = ko.observable(null);
                window.editMsg      = ko.observable(null);
                window.forwardMsgs  = ko.observableArray([]);
                this.messages       = window.messages;
                this.selectedMsgs   = window.selectedMsgs;
                this.pinnedMsg      = window.pinnedMsg;
                this.replyTo        = window.replyTo;
                this.editMsg        = window.editMsg;
                this.forwardMsgs    = window.forwardMsgs;
                this.selectionLabel = ko.pureComputed(() => window.MSG_STR.selected.replace("%COUNT%", this.selectedMsgs().length));
                this.messageContent = ko.observable("");

                this.sendMessage = model => {
                    const content = model.messageContent();
                    if(window.editMsg()) {
                        if(content.trim() === "") return false;

                        window.Msg.saveEdit(content);
                        model.messageContent("");
                        window.Msg.autosizeInput();
                        return;
                    }

                    if(content.trim() === "" && collect_attachments(u("#write")).length === 0 && model.forwardMsgs().length === 0) return false;

                    window.Msg.sendMessage(content);
                    model.messageContent("");
                    window.Msg.autosizeInput();
                };

                this.onMessagesScroll = (model, e) => {
                    window.Msg.onScroll();
                    if(e.target.scrollTop < 21) window.Msg.loadHistory();
                };

                this.onTextareaKeyPress = (model, e) => {
                    if(e.key === "Escape" && window.editMsg()) {
                        window.Msg.cancelEdit();
                        return false;
                    }

                    if(e.which === 13 && !e.metaKey && !e.shiftKey && !e.ctrlKey) {
                        const ta = e.target;
                        ta.blur(); // knockout забирает значение по blur
                        model.sendMessage(model);
                        ta.focus();

                        return false;
                    }

                    return true;
                };

                this.onTextareaInput = (model, e) => {
                    window.Msg.autosize(e.target);
                    if(!window.editMsg()) window.Msg.sendTypingActivity();
                    return true;
                };
            }

            class Messenger {
                constructor() {
                    this.root     = document.querySelector(".im-chat");
                    this.ko       = ko.applyBindings(new MessengerViewModel(), this.root);
                    this.appEl    = this.root.querySelector(".im-chat--history");
                    this.typeEl   = this.root.querySelector(".im-chat--typing");
                    this.offset   = 0; // самое старое загруженное id, для подгрузки истории вверх
                    this.newestId = 0; // самое новое известное id, для поллинга
                    this.historyEnd = false;
                    this.atBottom   = true;
                    this.lastSync   = Math.floor(Date.now() / 1000);
                    this.typingTimer = null;

                    this._loadHistory();
                    this._setupPolling();
                    this.scrollToBottom();

                    // картинки догружаются позже и сдвигают ленту
                    this.appEl.addEventListener("load", e => {
                        if(e.target.tagName === "IMG" && this.atBottom) this.scrollToBottom();
                    }, true);
                }

                get alive() {
                    return document.body.contains(this.appEl);
                }

                scrollToBottom() {
                    this.appEl.scrollTop = this.appEl.scrollHeight;
                }

                onScroll() {
                    this.atBottom = this.appEl.scrollHeight - this.appEl.scrollTop - this.appEl.clientHeight < 30;
                    this.scheduleFloatingDate();
                }

                hydrate() {
                    normalizeAudio(this.appEl);
                    this.appEl.querySelectorAll(".bsdn").forEach(el => {
                        if(!el.querySelector(".bdsn-hydrated") && typeof bsdnInitElement === "function") bsdnInitElement(el);
                    });
                }

                autosize(ta) {
                    ta.style.height = "auto";
                    ta.style.height = Math.min(ta.scrollHeight + 2, 200) + "px";
                }

                autosizeInput() {
                    const ta = document.querySelector("#write textarea[name=message]");
                    if(ta) this.autosize(ta);
                }

                _loadHistory() {
                    if(this.historyEnd) return;

                    const xhr = new XMLHttpRequest();
                    xhr.open("GET", `${ API_BASE }/${ this.offset }.json`, false);
                    xhr.send();

                    let messages = [];
                    try {
                        messages = JSON.parse(xhr.responseText);
                    } catch(e) {}

                    if(messages.length === 0) this.historyEnd = true;

                    const lastMessage = messages[messages.length - 1];
                    if(typeof lastMessage !== "undefined") this.offset = lastMessage.uuid;

                    // курсор поллинга ставится один раз, по самой свежей пачке
                    if(this.newestId === 0 && messages.length > 0) this.newestId = messages[0].uuid;

                    // сохраняем позицию, иначе история грузится цепочкой до самого верха
                    const oldTop = this.appEl.scrollTop, oldHeight = this.appEl.scrollHeight;
                    messages.forEach(m => window.messages.unshift(m));
                    this.appEl.scrollTop = oldTop + (this.appEl.scrollHeight - oldHeight);
                    this.hydrate();
                }

                loadHistory() {
                    this._loadHistory();
                }

                // догружаем историю, пока лента не начнёт скроллиться
                fillHistory() {
                    let loaded = false;
                    while(!this.historyEnd && this.appEl.scrollHeight <= this.appEl.clientHeight) {
                        this._loadHistory();
                        loaded = true;
                    }

                    if(loaded) this.scrollToBottom();
                }

                // короткий поллинг новых, изменённых и удалённых сообщений
                _setupPolling(intervalMs = 3500) {
                    const poll = () => {
                        if(!this.alive) return;

                        const xhr = new XMLHttpRequest();
                        xhr.open("GET", `/im/api/sync${ PEER_ID }/${ this.newestId }.json?since=${ this.lastSync }`, true);
                        xhr.onload = () => {
                            let data = null;
                            try {
                                data = xhr.status === 200 ? JSON.parse(xhr.responseText) : null;
                            } catch(e) {}

                            if(data) {
                                (data.messages || []).forEach(message => {
                                    if(this.newestId >= message.uuid) return;
                                    this.newestId = message.uuid;
                                    if(window.messages().some(m => m.uuid === message.uuid)) return;
                                    this.addMessage(message);
                                });

                                (data.edited || []).forEach(message => this.updateMessage(message));
                                this.removeMessages(data.deleted || []);

                                if(typeof data.pinned !== "undefined") this.setPinned(data.pinned);
                                if(data.typing) this.setTypingStatus();
                                if(typeof data.ts === "number") this.lastSync = data.ts;
                            }

                            setTimeout(poll, intervalMs);
                        };
                        xhr.onerror = () => setTimeout(poll, intervalMs * 2);
                        xhr.send();
                    };
                    poll();
                }

                scheduleFloatingDate() {
                    if(this._floatingDateFrame) return;

                    this._floatingDateFrame = requestAnimationFrame(() => {
                        this._floatingDateFrame = null;
                        this.updateFloatingDate();
                    });
                }

                // плашка с датой первого видимого сообщения
                updateFloatingDate() {
                    const wrap = this.appEl.querySelector(".im_floating_date_wrap");
                    const top  = this.appEl.getBoundingClientRect().top;

                    const first = [...this.appEl.querySelectorAll(".im-mess")].find(el => el.getBoundingClientRect().bottom > top);
                    const msg   = first ? ko.dataFor(first) : null;
                    const dividerAtTop = [...this.appEl.querySelectorAll(".im-chat--day")].some(el => {
                        const rect = el.getBoundingClientRect();
                        return rect.top >= top - 12 && rect.bottom <= top + 50;
                    });

                    if(!msg || typeof msg.timing.ts !== "number" || dividerAtTop || this.appEl.scrollHeight <= this.appEl.clientHeight) {
                        wrap.style.opacity = 0;
                        return;
                    }

                    wrap.firstElementChild.textContent = window.msgDay(msg.timing.ts);
                    wrap.style.opacity = 1;
                }

                addMessage(message, scroll = true) {
                    window.messages.push(message);
                    this.hydrate();
                    if(scroll) this.scrollToBottom();
                }

                updateMessage(message) {
                    const msgs = window.messages();
                    for(let i = 0; i < msgs.length; i++) {
                        if(msgs[i].uuid !== message.uuid) continue;

                        window.messages.splice(i, 1, Object.assign({}, msgs[i], { text: message.text, timing: message.timing }));
                        break;
                    }
                }

                removeMessages(ids) {
                    if(ids.length === 0) return;

                    window.messages.remove(m => ids.includes(m.uuid));
                    window.selectedMsgs.remove(id => ids.includes(id));
                    if(window.editMsg() && ids.includes(window.editMsg().uuid)) this.cancelEdit();
                }

                // шлём не чаще раза в 3 секунды, пока юзер печатает
                sendTypingActivity() {
                    if(IS_SELF) return;

                    const now = Date.now();
                    if(this.lastTypingSentAt && now - this.lastTypingSentAt < 3000) return;
                    this.lastTypingSentAt = now;

                    const fd = new FormData();
                    fd.set("hash", CSRF);
                    fetch(`${ API_BASE }/typing.json`, { method: "POST", body: fd }).catch(Function.noop);
                }

                setTypingStatus() {
                    if(!this.typeEl) return;

                    clearTimeout(this.typingTimer);
                    this.typeEl.style.display = "block";
                    this.typeEl.style.opacity = 1;
                    if(this.atBottom) this.scrollToBottom();

                    this.typingTimer = setTimeout(() => {
                        this.typeEl.style.opacity = 0;
                        setTimeout(() => this.typeEl.style.display = "none", 250);
                    }, 6000);
                }

                _patchMessage(tempId, message) {
                    const msgs = window.messages();
                    for(let i = msgs.length - 1; i > -1; i--) {
                        if(msgs[i]._tuid !== tempId) continue;

                        window.messages.splice(i, 1, message);
                        this.hydrate();
                        return;
                    }
                }

                _newSelfMessage(content = "") {
                    return {
                        sender: {
                            id:     window.MSG_ME,
                            link:   {$thisUser->getURL()},
                            avatar: {$thisUser->getAvatarUrl()},
                            name:   {$thisUser->getFirstName()},
                        },
                        timing: {
                            sent:   "<img src=\"/assets/packages/static/openvk/img/loading_mini.gif\" alt=\"\">",
                            ts:     Math.floor(Date.now() / 1000),
                            edited: null,
                        },
                        text:        content,
                        read:        false,
                        attachments: [],
                        reply:       null,
                        fwd:         [],
                        _tuid:       Math.ceil(performance.now()),
                    };
                }

                _failMessage(tempId) {
                    this._patchMessage(tempId, {
                        sender: {
                            avatar: "/assets/packages/static/openvk/img/oof.apng",
                            id:     -1,
                            link:   "/support/manpages/messages/not-delivered.html",
                            name:   window.MSG_STR.error,
                        },
                        text:        window.MSG_STR.errorText,
                        timing:      { edited: null, sent: "???", ts: null },
                        read:        true,
                        attachments: [],
                        reply:       null,
                        fwd:         [],
                        uuid:        -4096,
                    });
                }

                // ответ сервера мог прийти позже, чем поллинг принёс это же сообщение
                _settle(tempId, sent) {
                    if(window.messages().some(m => m.uuid === sent.uuid))
                        window.messages.remove(m => m._tuid === tempId);
                    else
                        this._patchMessage(tempId, sent);

                    if(sent.uuid > this.newestId) this.newestId = sent.uuid;
                }

                setPinned(msg) {
                    if(JSON.stringify(window.pinnedMsg()) !== JSON.stringify(msg)) window.pinnedMsg(msg);
                }

                scrollToMessage(uuid) {
                    const el = this.appEl.querySelector(`.im-mess[data-uuid="${ uuid }"]`);
                    if(!el) return;

                    el.scrollIntoView({ block: "center", behavior: "smooth" });
                    el.classList.add("im-mess_highlighted");
                    setTimeout(() => el.classList.remove("im-mess_highlighted"), 1500);
                }

                // догружаем историю, пока исходное сообщение не окажется в ленте
                goToMessage(uuid) {
                    for(let i = 0; i < 30 && !this.historyEnd && !window.messages().some(m => m.uuid === uuid); i++) {
                        this._loadHistory();
                    }

                    this.scrollToMessage(uuid);
                }

                async _post(url, data = {}) {
                    const fd = new FormData();
                    fd.set("hash", CSRF);
                    Object.entries(data).forEach(([k, v]) => fd.set(k, v));

                    const res = await fetch(url, { method: "POST", body: fd });
                    if(!res.ok) throw new Error(res.status);

                    return res.json();
                }

                async pinMessage(msgId) {
                    if(msgId !== 0 && window.pinnedMsg()?.uuid === msgId) msgId = 0;

                    try {
                        const res = await this._post(`${ API_BASE }/pin.json`, { msg_id: msgId });
                        this.setPinned(res.pinned);
                    } catch(e) {
                        fastError(window.MSG_STR.error);
                    }
                }

                // выбор диалога в окне, затем сообщения прикрепляются к полю ввода
                forwardMessages(msgIds) {
                    const msgs = window.messages()
                        .filter(m => msgIds.includes(m.uuid))
                        .sort((a, b) => a.uuid - b.uuid)
                        .map(m => ({ uuid: m.uuid, name: m.sender.name, text: window.plainText(m.text) }));
                    if(msgs.length === 0) return;

                    const box  = MessageBox(window.MSG_STR.forwardTo, `<div class="im-fwd-picker"></div>`, [window.MSG_STR.cancel], [Function.noop], true);
                    box.getNode().addClass("im-fwd-picker-box");
                    const list = box.getNode().find(".im-fwd-picker").first();

                    // сначала обычные чаты, потом архив, подгрузка при прокрутке
                    let page = 1, archived = 0, loading = false, done = false;
                    const loadMore = async () => {
                        if(loading || done) return;
                        loading = true;

                        try {
                            const res = await (await fetch(`/im/api/dialogs.json?p=${ page }&archived=${ archived }`)).json();
                            list.insertAdjacentHTML("beforeend", res.items.map(d => `
                                <a class="im-fwd-picker--item" data-id="${ d.id }">
                                    <img src="${ escapeHtml(d.id === window.MSG_ME ? SAVED_AVATAR : d.avatar) }" alt="" />
                                    <span>${ escapeHtml(d.id === window.MSG_ME ? window.MSG_STR.saved : d.name) }</span>
                                </a>
                            `).join(""));

                            if(res.more) {
                                page++;
                            } else if(!archived) {
                                archived = 1;
                                page = 1;
                            } else {
                                done = true;
                                if(!list.children.length) list.textContent = window.MSG_STR.noDialogs;
                            }
                        } catch(e) {
                            done = true;
                            fastError(window.MSG_STR.error);
                        }

                        loading = false;
                        if(!done && list.scrollHeight <= list.clientHeight) loadMore();
                    };

                    list.addEventListener("scroll", () => {
                        if(list.scrollTop + list.clientHeight > list.scrollHeight - 50) loadMore();
                    });
                    loadMore();

                    list.addEventListener("click", e => {
                        const item = e.target.closest(".im-fwd-picker--item");
                        if(!item) return;

                        const id = Number(item.dataset.id);
                        box.close();
                        window.selectedMsgs.removeAll();

                        if(id === PEER_ID) {
                            this.cancelEdit();
                            window.forwardMsgs(msgs);
                            this.focusInput();
                            return;
                        }

                        try {
                            sessionStorage.setItem("im.forward", JSON.stringify(msgs));
                        } catch(err) {
                            return fastError(window.MSG_STR.error);
                        }

                        window.router.navigate(`/im?sel=${ id }&forward=1`);
                    });
                }

                // пересылка, выбранная в другом диалоге
                takeForward() {
                    const params = new URLSearchParams(location.search);
                    if(!params.has("forward")) return;

                    try {
                        const msgs = JSON.parse(sessionStorage.getItem("im.forward") || "[]");
                        sessionStorage.removeItem("im.forward");
                        window.forwardMsgs(Array.isArray(msgs) ? msgs : []);
                    } catch(e) {}

                    params.delete("forward");
                    history.replaceState(history.state, "", location.pathname + "?" + params);
                }

                clearForward() {
                    window.forwardMsgs([]);
                }

                focusInput() {
                    document.querySelector("#write textarea[name=message]")?.focus();
                }

                // редактирование прямо в поле ввода, как во вконтакте
                editMessage(msg) {
                    if(!(msg.uuid > 0)) return;

                    window.replyTo(null);
                    window.forwardMsgs([]);
                    window.editMsg({ uuid: msg.uuid, text: msg.text });

                    const ta = document.querySelector("#write textarea[name=message]");
                    if(!ta) return;

                    ko.dataFor(this.root).messageContent(window.plainText(msg.text));
                    this.autosize(ta);
                    ta.focus();
                    ta.setSelectionRange(ta.value.length, ta.value.length);
                }

                cancelEdit() {
                    if(!window.editMsg()) return;

                    window.editMsg(null);
                    ko.dataFor(this.root).messageContent("");
                    this.autosizeInput();
                }

                async saveEdit(content) {
                    const msgId = window.editMsg().uuid;
                    window.editMsg(null);

                    try {
                        const updated = await this._post(`${ API_BASE }/${ msgId }/edit.json`, { content });
                        this.updateMessage(updated);
                    } catch(e) {
                        fastError(window.MSG_STR.error);
                    }
                }

                replyMessage(msg) {
                    if(!(msg.uuid > 0)) return;

                    this.cancelEdit();
                    window.replyTo({ uuid: msg.uuid, sender: { name: msg.sender.name }, text: msg.text });
                    this.focusInput();
                }

                clearReply() {
                    window.replyTo(null);
                }

                // клик по цитате ведёт к исходному сообщению, клик по ссылке внутри работает как обычно
                onReplyClick(reply, e) {
                    if(e.target.closest("a")) return true;

                    this.goToMessage(reply.uuid);
                }

                deleteMessages(msgIds) {
                    msgIds = [...msgIds];
                    const hasOwn = window.messages().some(m => msgIds.includes(m.uuid) && m.sender.id === window.MSG_ME);

                    let body = window.MSG_STR.deleteText.replace("%COUNT%", msgIds.length);
                    if(hasOwn && !IS_SELF)
                        body += `<br><br><label class="checkbox"><input type="checkbox" id="msg_delete_for_all" checked> <span>${ window.MSG_STR.deleteForAll }</span></label>`;

                    MessageBox(window.MSG_STR.deleteTitle, body, [window.MSG_STR.delete, window.MSG_STR.cancel], [
                        async () => {
                            const forAll = IS_SELF || (document.getElementById("msg_delete_for_all")?.checked ?? false);
                            try {
                                const res = await this._post(`${ API_BASE }/delete-many.json`, {
                                    ids:     msgIds.join(","),
                                    for_all: forAll ? "1" : "0",
                                });
                                this.removeMessages([...res.deleted, ...res.hidden]);
                            } catch(e) {
                                fastError(window.MSG_STR.error);
                            }
                        },
                        Function.noop,
                    ]);
                }

                // стикер уходит сразу отдельным сообщением, без текста
                async sendSticker(sticker) {
                    const msg = this._newSelfMessage("");
                    msg.attachments = [{ type: "sticker", id: sticker.id, sticker: { pack: sticker.pack, url: sticker.url, emoji: sticker.emoji } }];
                    this.addMessage(msg);

                    const fd = new FormData();
                    fd.set("hash", CSRF);
                    fd.set("content", "");
                    fd.set("attachments", "sticker" + sticker.id);
                    if(window.replyTo()) {
                        fd.set("reply_to", window.replyTo().uuid);
                        this.clearReply();
                    }

                    try {
                        const res = await fetch(`${ API_BASE }/create.json`, { method: "POST", body: fd });
                        if(res.status !== 202) throw new Error(res.status);

                        this._settle(msg._tuid, await res.json());
                    } catch(e) {
                        window.messages.remove(m => m._tuid === msg._tuid);
                        fastError(window.MSG_STR.error);
                    }
                }

                async sendMessage(content) {
                    const form = document.querySelector("#write");
                    const attachments = form ? collect_attachments(u(form)) : [];

                    const preview = this._newSelfMessage(encode_emojis(escapeHtml(content)));
                    const tempId  = preview._tuid;
                    this.addMessage(preview);

                    const fd = new FormData();
                    fd.set("content", content);
                    fd.set("hash", CSRF);
                    if(window.replyTo()) {
                        fd.set("reply_to", window.replyTo().uuid);
                        this.clearReply();
                    }

                    if(window.forwardMsgs().length > 0) {
                        fd.set("forward_messages", window.forwardMsgs().map(m => m.uuid).join(","));
                        this.clearForward();
                    }

                    if(attachments.length > 0) fd.set("attachments", attachments.join(","));

                    if(form) {
                        form.querySelector(".post-horizontal").innerHTML = "";
                        form.querySelector(".post-vertical").innerHTML = "";
                    }

                    try {
                        const res = await fetch(`${ API_BASE }/create.json`, { method: "POST", body: fd });
                        if(res.status !== 202) throw new Error(res.status);

                        this._settle(tempId, await res.json());
                    } catch(e) {
                        console.error("Message was not sent", e);
                        this._failMessage(tempId);
                    }
                }
            }

            const messenger = window.Msg = new Messenger();
            messenger.takeForward();
            messenger.fillHistory();

            const form = document.querySelector("#write");
            form?.addEventListener("sticker:send", e => {
                e.preventDefault();
                messenger.sendSticker(e.detail);
            });

            // слушатели привязаны к своему экземпляру: при ajax-переходе в другой чат они отписываются
            const onResize = () => {
                if(!messenger.alive) return window.removeEventListener("resize", onResize);

                if(messenger.atBottom) messenger.scrollToBottom();
                messenger.fillHistory();
            };
            window.addEventListener("resize", onResize);
            window.messages.subscribe(() => messenger.scheduleFloatingDate());

            // поле ввода растёт, ширина ленты меняется при перетаскивании границы — держимся внизу
            const sizeObserver = new ResizeObserver(() => {
                if(!messenger.alive) return sizeObserver.disconnect();
                if(messenger.atBottom) messenger.scrollToBottom();
            });
            sizeObserver.observe(messenger.appEl);
            const input = document.querySelector(".im-chat--input");
            if(input) sizeObserver.observe(input);

            const msgAction = (act, msg) => {
                switch(act) {
                    case "pin":     return window.Msg.pinMessage(msg.uuid);
                    case "edit":    return window.Msg.editMessage(msg);
                    case "reply":   return window.Msg.replyMessage(msg);
                    case "forward": return window.Msg.forwardMessages([msg.uuid]);
                    case "delete":  return window.Msg.deleteMessages([msg.uuid]);
                }
            };

            const historyEl = messenger.appEl;
            const IGNORE_CLICKS = "a, button, video, audio, input, textarea, .bsdn, .im-mess--attachments, .im-mess--tools, .im-replied, .im-fwd--list";

            // выделение сообщений и действия из мини-меню
            historyEl.addEventListener("click", e => {
                const tool = e.target.closest(".im-mess--tool[data-act]");
                if(tool) {
                    e.preventDefault();
                    if(tool.dataset.act !== "more") msgAction(tool.dataset.act, ko.dataFor(tool));
                    return;
                }

                const photo = e.target.closest(".photoMessengerOpen");
                if(photo) {
                    e.preventDefault();
                    e.stopPropagation();
                    const img = photo.querySelector("img");
                    if(img && photo.dataset.photoId) OpenMiniature(e, img.src, null, photo.dataset.photoId, null);
                    return;
                }

                const video = e.target.closest(".videoMessengerOpen");
                if(video) {
                    e.preventDefault();
                    e.stopPropagation();
                    const id = video.dataset.videoId ?? "";
                    if(id.includes("_")) OpenVideo(id.split("_"));
                    return;
                }

                const el = e.target.closest(".im-mess");
                if(!el || e.target.closest(IGNORE_CLICKS)) return;
                if(window.getSelection().toString() !== "") return;

                const uuid = ko.dataFor(el).uuid;
                if(!(uuid > 0)) return;

                window.selectedMsgs.indexOf(uuid) === -1 ? window.selectedMsgs.push(uuid) : window.selectedMsgs.remove(uuid);
            });

            // двойной клик по сообщению — ответить
            historyEl.addEventListener("dblclick", e => {
                const el = e.target.closest(".im-mess");
                if(!el || e.target.closest(IGNORE_CLICKS) || !document.querySelector("#write textarea")) return;

                window.getSelection().removeAllRanges();
                window.Msg.replyMessage(ko.dataFor(el));
            });

            const menuOptions = {
                theme: "light vk",
                animation: "up_down",
                content: "",
                allowHTML: true,
                interactive: true,
                trigger: "click",
                arrow: false,
                zIndex: 1000,
                appendTo: () => document.body,
            };

            const buildMenu = (items, tip) => {
                const menu = document.createElement("div");
                menu.className = "tippy-menu";

                items.forEach(([text, handler, danger]) => {
                    const link = document.createElement("a");
                    link.textContent = text;
                    if(danger) link.className = "msg-menu-danger";
                    link.addEventListener("click", e => {
                        e.preventDefault();
                        tip.hide();
                        handler();
                    });
                    menu.append(link);
                });

                return menu;
            };

            tippy.delegate(historyEl, {
                ...menuOptions,
                target: ".im-mess--tool_more",
                placement: "bottom-end",
                offset: [0, 6],
                onShow(tip) {
                    const msg = ko.dataFor(tip.reference);
                    const isPinned = window.pinnedMsg()?.uuid === msg.uuid;
                    tip.reference.closest(".im-mess")?.classList.add("im-mess_menu-open");
                    tip.setContent(buildMenu([
                        [isPinned ? window.MSG_STR.unpin : window.MSG_STR.pin, () => msgAction("pin", msg)],
                        [window.MSG_STR.forward, () => msgAction("forward", msg)],
                        [window.MSG_STR.delete, () => msgAction("delete", msg), true],
                    ], tip));
                },
                onHidden(tip) {
                    tip.reference.closest(".im-mess")?.classList.remove("im-mess_menu-open");
                },
            });

            // рычажок широкоэкранного режима меняет размеры ленты на месте
            const onLayout = () => {
                if(!messenger.alive) return document.removeEventListener("im:layout", onLayout);

                requestAnimationFrame(() => {
                    if(messenger.atBottom) messenger.scrollToBottom();
                    messenger.fillHistory();
                    messenger.scheduleFloatingDate();
                });
            };
            document.addEventListener("im:layout", onLayout);

            // меню чата и окно с вложениями и информацией о собеседнике
            const PEER_STR = {
                title:      {tr("messenger_chat_info")},
                shortcode:  {tr("messenger_info_shortcode")},
                birthday:   {tr("messenger_info_birthday")},
                empty:      {tr("messenger_info_empty")},
                block:      {tr("messenger_block_user")},
                unblock:    {tr("messenger_unblock_user")},
                report:     {tr("report")},
                del:        {tr("messenger_delete_chat")},
                delText:    {tr("messenger_delete_chat_confirm", "%NAME%")},
                delForAll:  {tr("messenger_delete_chat_for_all", "%NAME%")},
                delBtn:     {tr("delete")},
                cancel:     {tr("cancel")},
                blockText:  {tr("adding_to_bl_sure", "%NAME%")},
                blockTitle: {tr("addition_to_bl")},
                yes:        {tr("yes")},
                no:         {tr("no")},
            };

            let peerInfo = null, peerInfoRequest = null;
            const fetchPeerInfo = () => peerInfoRequest ??= fetch(`/im/api/peer${ PEER_ID }.json`)
                .then(res => res.json())
                .then(info => peerInfo = info)
                .catch(e => {
                    peerInfoRequest = null;
                    throw e;
                });

            const askDeleteChat = info => {
                const name = escapeHtml(info.name);
                let text = PEER_STR.delText.replace("%NAME%", name);
                if(!info.self)
                    text += `<br><br><label class="checkbox"><input type="checkbox" id="im_peer_delete_for_all"> <span>${ PEER_STR.delForAll.replace("%NAME%", name) }</span></label>`;

                MessageBox(PEER_STR.del, text, [PEER_STR.delBtn, PEER_STR.cancel], [async () => {
                    const fd = new FormData();
                    fd.set("hash", CSRF);
                    fd.set("sel", PEER_ID);
                    fd.set("act", "delete");
                    fd.set("for_all", document.getElementById("im_peer_delete_for_all")?.checked ? "1" : "0");

                    const res = await fetch("/im/api/dialogs/action.json", { method: "POST", body: fd });
                    if(!res.ok) return fastError(window.MSG_STR.error);

                    window.router.navigate("/im");
                }, Function.noop]);
            };

            const toggleBlock = (info, onDone = Function.noop) => {
                const call = async method => {
                    try {
                        await window.OVKAPI.call(method, { owner_id: info.peer_id });
                        info.blocked = !info.blocked;
                        onDone();
                    } catch(e) {
                        fastError(e.message);
                    }
                };

                if(info.blocked) return call("account.unban");

                MessageBox(PEER_STR.blockTitle, escapeHtml(PEER_STR.blockText.replace("%NAME%", info.name)), [PEER_STR.yes, PEER_STR.no], [
                    () => call("account.ban"),
                    Function.noop,
                ]);
            };

            const renderAttachment = (kind, item) => {
                switch(kind) {
                    case "photo":
                        return `<a class="im-pinfo--photo" href="/photo${ escapeHtml(item.id) }" data-id="${ escapeHtml(item.id) }" data-url="${ escapeHtml(item.url) }"><img src="${ escapeHtml(item.thumb) }" alt="" loading="lazy" /></a>`;
                    case "gif":
                        return `<a class="im-pinfo--photo" href="${ escapeHtml(item.link) }"><img src="${ escapeHtml(item.url) }" alt="" loading="lazy" /></a>`;
                    case "video":
                        return `
                            <a class="im-pinfo--att im-pinfo--video" data-id="${ escapeHtml(item.id) }">
                                <img src="${ escapeHtml(item.thumb) }" alt="" loading="lazy" />
                                <span class="im-pinfo--att-name">${ escapeHtml(item.name) }</span>
                                <span class="im-pinfo--att-meta">${ escapeHtml(item.length) }</span>
                            </a>`;
                    case "doc":
                        return `
                            <a class="im-pinfo--att" href="${ escapeHtml(item.link) }">
                                ${ item.preview
                                    ? `<img src="${ escapeHtml(item.preview) }" alt="" loading="lazy" />`
                                    : `<span class="im-pinfo--att-ext">${ escapeHtml(item.ext) }</span>` }
                                <span class="im-pinfo--att-name">${ escapeHtml(item.name) }</span>
                                <span class="im-pinfo--att-meta">${ escapeHtml(item.size) }</span>
                            </a>`;
                    case "audio":
                        return `<div class="im-pinfo--audio msg-attach-j-audio">${ item.html }</div>`;
                }
            };

            const openPeerInfo = async () => {
                if(document.querySelector(".im-pinfo-box")) return;

                let info;
                try {
                    info = await fetchPeerInfo();
                } catch(e) {
                    return fastError(window.MSG_STR.error);
                }

                const msg = new CMessageBox({
                    title: `<a class="im-pinfo--back" hidden></a><span class="im-pinfo--title">${ escapeHtml(PEER_STR.title) }</span>`,
                    body: `
                        <div class="im-pinfo" data-page="main">
                            <div class="im-pinfo--head">
                                <a class="im-pinfo--ava" href="${ escapeHtml(info.link) }"><img src="${ escapeHtml(info.avatar) }" alt="" /></a>
                                <div class="im-pinfo--headinfo">
                                    <a class="im-pinfo--name" href="${ escapeHtml(info.link) }">${ escapeHtml(info.name) }</a>
                                    ${ info.shortcode ? `<a class="im-pinfo--short" href="${ escapeHtml(info.link) }">@${ escapeHtml(info.shortcode) }</a>` : "" }
                                </div>
                            </div>
                            ${ info.birthday ? `
                                <div class="im-pinfo--block">
                                    <div class="im-pinfo--fact">
                                        <div class="im-pinfo--fact-label">${ escapeHtml(PEER_STR.birthday) }</div>
                                        <div class="im-pinfo--fact-value">${ escapeHtml(info.birthday) }</div>
                                    </div>
                                </div>` : "" }
                            ${ info.counts.length ? `
                                <div class="im-pinfo--block">
                                    ${ info.counts.map(c => `
                                        <a class="im-pinfo--row im-pinfo--row_${ escapeHtml(c.kind) }" data-kind="${ escapeHtml(c.kind) }" data-title="${ escapeHtml(c.title) }">
                                            <span class="im-pinfo--icon"></span>
                                            <span class="im-pinfo--label">${ escapeHtml(c.label) }</span>
                                        </a>`).join("") }
                                </div>` : "" }
                            <div class="im-pinfo--block">
                                <a class="im-pinfo--row im-pinfo--row_delete" data-act="delete">
                                    <span class="im-pinfo--icon"></span>
                                    <span class="im-pinfo--label">${ escapeHtml(PEER_STR.del) }</span>
                                </a>
                                ${ info.blocked !== null ? `
                                    <a class="im-pinfo--row im-pinfo--row_block" data-act="block">
                                        <span class="im-pinfo--icon"></span>
                                        <span class="im-pinfo--label">${ escapeHtml(info.blocked ? PEER_STR.unblock : PEER_STR.block) }</span>
                                    </a>` : "" }
                            </div>
                        </div>
                        <div class="im-pinfo im-pinfo--list" data-page="list" hidden></div>
                    `,
                    buttons: [],
                    callbacks: [],
                });

                const node = msg.getNode();
                node.addClass("im-pinfo-box");

                const root    = node.first();
                const body    = root.querySelector(".ovk-diag-body");
                const main    = root.querySelector('[data-page="main"]');
                const list    = root.querySelector('[data-page="list"]');
                const title   = root.querySelector(".im-pinfo--title");
                const backBtn = root.querySelector(".im-pinfo--back");
                const close   = () => msg.close();

                // подгрузка вложений выбранного типа при прокрутке
                let current = null;
                const loadMore = async () => {
                    const state = current;
                    if(!state || state.loading || state.done) return;
                    state.loading = true;

                    try {
                        const res = await (await fetch(`/im/api/peer${ PEER_ID }/attachments.json?type=${ state.kind }&offset=${ state.offset }`)).json();
                        if(state !== current) return;

                        state.offset += res.items.length;
                        state.done = !res.more;
                        list.insertAdjacentHTML("beforeend", res.items.map(item => renderAttachment(state.kind, item)).join(""));
                        normalizeAudio(list);
                        if(state.offset === 0) list.innerHTML = `<div class="im-pinfo--empty">${ escapeHtml(PEER_STR.empty) }</div>`;
                    } catch(e) {
                        state.done = true;
                        fastError(window.MSG_STR.error);
                    }

                    state.loading = false;
                    if(!state.done && body.scrollHeight <= body.clientHeight) loadMore();
                };
                body.addEventListener("scroll", () => {
                    if(body.scrollTop + body.clientHeight > body.scrollHeight - 100) loadMore();
                });

                const showMain = () => {
                    current = null;
                    title.textContent = PEER_STR.title;
                    list.hidden = true;
                    main.hidden = false;
                    backBtn.hidden = true;
                    node.removeClass("im-pinfo-box_list");
                };

                const showKind = (kind, kindTitle) => {
                    current = { kind, offset: 0, loading: false, done: false };
                    title.textContent = kindTitle;
                    list.className = `im-pinfo im-pinfo--list im-pinfo--list_${ kind }`;
                    list.innerHTML = "";
                    main.hidden = true;
                    list.hidden = false;
                    backBtn.hidden = false;
                    node.addClass("im-pinfo-box_list");
                    body.scrollTop = 0;
                    loadMore();
                };

                backBtn.addEventListener("click", showMain);

                body.addEventListener("click", e => {
                    const row = e.target.closest(".im-pinfo--row[data-kind]");
                    if(row) return showKind(row.dataset.kind, row.dataset.title);

                    const act = e.target.closest(".im-pinfo--row[data-act]");
                    if(act) {
                        close();
                        return act.dataset.act === "delete" ? askDeleteChat(info) : toggleBlock(info);
                    }

                    const photo = e.target.closest(".im-pinfo--photo[data-id]");
                    if(photo) {
                        e.preventDefault();
                        close();
                        return OpenMiniature(e, photo.dataset.url, null, photo.dataset.id, null);
                    }

                    const video = e.target.closest(".im-pinfo--video");
                    if(video) {
                        close();
                        return OpenVideo(video.dataset.id.split("_"));
                    }
                });
            };

            document.querySelector(".im-chat--ava")?.addEventListener("click", e => {
                e.preventDefault();
                openPeerInfo();
            });

            const moreBtn = document.querySelector(".im-chat--more");
            if(moreBtn) tippy(moreBtn, {
                ...menuOptions,
                placement: "bottom-end",
                offset: [0, 0],
                onShow(tip) {
                    const render = () => {
                        const info  = peerInfo;
                        const items = [[PEER_STR.title, openPeerInfo]];
                        if(info && info.blocked !== null) {
                            items.push([info.blocked ? PEER_STR.unblock : PEER_STR.block, () => toggleBlock(info)]);
                            items.push([PEER_STR.report, () => reportUser(info.peer_id)]);
                        }
                        if(info) items.push([PEER_STR.del, () => askDeleteChat(info), true]);

                        tip.setContent(buildMenu(items, tip));
                    };

                    render();
                    if(!peerInfo) fetchPeerInfo().then(render).catch(Function.noop);
                },
            });
        })();
    </script>
{/block}

{define imChat}
    <div class="im-chat">
        <div class="im-chat--head">
            <div class="im-chat--head-main">
                <a class="im-chat--back" href="/im">{_paginator_back}</a>
                <div class="im-chat--peer">
                    <a class="im-chat--peer-name" href="{$isSelf ? '/im?sel=' . $thisUser->getId() : $correspondent->getURL()}">{$peerName}</a>
                    {if !$isClub && !$isSelf}
                        <span class="im-chat--peer-status">
                            {if $peerOnline}
                                {_online|lower}
                            {elseif $correspondent->getOnline()->timestamp() + 2505600 > time()}
                                {$correspondent->isFemale() ? tr("was_online_f") : tr("was_online_m")} {$correspondent->getOnline()}
                            {/if}
                        </span>
                    {/if}
                </div>
                <div class="im-chat--actions">
                    <a class="im-chat--more" title="{_messenger_more}"></a>
                    <a class="im-chat--ava" title="{_messenger_chat_info}">
                        {if $isSelf}
                            <img src="/assets/packages/static/openvk/img/im/saved_messages.png" class="avatar" width="30" height="30" alt="{_saved_messages}" />
                        {else}
                            {include '../components/avatar.latte', author => $correspondent, size => 'miniscule', width => 30, height => 30, alt => $peerName}
                        {/if}
                        <span n:if="$peerOnline" class="im-chat--online"></span>
                    </a>
                </div>
            </div>
            <div class="im-chat--selection" style="display: none;" data-bind="visible: selectedMsgs().length > 0">
                <a class="im-chat--sel-count" title="{_messenger_cancel_selection}" data-bind="click: () => selectedMsgs.removeAll()">
                    <span data-bind="text: selectionLabel()"></span>
                    <span class="im-chat--sel-clear"></span>
                </a>
                <div class="im-chat--sel-actions">
                    <a class="button button_gray" data-bind="click: () => window.Msg.forwardMessages(selectedMsgs())">{_messenger_forward}</a>
                    <a class="button button_gray" data-bind="click: () => window.Msg.deleteMessages(selectedMsgs())">{_messenger_delete}</a>
                </div>
            </div>
        </div>

        <!-- ko with: pinnedMsg -->
        <div class="im-chat--pinned" data-bind="click: () => window.Msg.goToMessage(uuid)">
            <div class="im-chat--pinned-body">
                <div class="im-chat--pinned-title">{_messenger_pinned_message}</div>
                <div class="im-chat--pinned-text"><b data-bind="text: sender.name"></b> <span data-bind="text: window.plainText(text) || window.MSG_STR.noText"></span></div>
            </div>
            <a class="im-chat--pinned-close" title="{_messenger_unpin_message}" data-bind="click: () => window.Msg.pinMessage(0), clickBubble: false"></a>
        </div>
        <!-- /ko -->

        <div class="im-chat--history" data-bind="event: { scroll: onMessagesScroll }">
            <div class="im_floating_date_wrap"><b></b></div>
            <div class="im-chat--history-inner">
                <div class="im-chat--messages" data-bind="foreach: messages">
                    <!-- ko if: window.isMsgNewDay($index()) -->
                    <div class="im-chat--day"><span data-bind="text: window.msgDay(timing.ts)"></span></div>
                    <!-- /ko -->
                    <div class="im-mess" data-bind="attr: { 'data-uuid': $data.uuid }, css: { 'im-mess_unread': !read, 'im-mess_grouped': window.isMsgGrouped($index()), 'im-mess_selected': $root.selectedMsgs.indexOf($data.uuid) !== -1, 'im-mess_replying': $root.replyTo() && $root.replyTo().uuid === $data.uuid, 'im-mess_editing': $root.editMsg() && $root.editMsg().uuid === $data.uuid, 'im-mess_pending': $data._tuid !== undefined }">
                        <div class="im-mess--check" data-bind="visible: $data.uuid > 0"></div>
                        <a class="im-mess--ava" data-bind="attr: { href: sender.link }"><img data-bind="attr: { src: sender.avatar, alt: sender.name }" /></a>
                        <div class="im-mess--body">
                            <!-- ko ifnot: window.isMsgGrouped($index()) -->
                            <div class="im-mess--head">
                                <a class="im-mess--author" data-bind="attr: { href: sender.link }, text: sender.name"></a>
                                <span class="im-mess--date" data-bind="html: window.msgTime($data)"></span>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: $data.reply -->
                            <div class="im-replied" data-bind="click: (d, e) => window.Msg.onReplyClick(reply, e), clickBubble: false">
                                <div class="im-replied--author">
                                    <a data-bind="attr: { href: reply.sender.link }, text: reply.sender.name"></a>
                                    <span class="im-replied--date" data-bind="text: window.msgFullDate(reply.ts)"></span>
                                </div>
                                <!-- ko if: reply.deleted -->
                                <div class="im-replied--text im-replied--text_muted">{_messenger_message_deleted}</div>
                                <!-- /ko -->
                                <!-- ko ifnot: reply.deleted -->
                                <div class="im-replied--text" data-bind="html: reply.text || window.MSG_STR.noText, css: { 'im-replied--text_muted': !reply.text }"></div>
                                <!-- /ko -->
                            </div>
                            <!-- /ko -->
                            <div class="im-mess--text" data-bind="html: text"></div>
                            <!-- ko template: 'msg-attachments-tpl' --><!-- /ko -->
                            <!-- ko if: $data.fwd && fwd.length -->
                            <div class="im-fwd--count" data-bind="text: window.fwdCountLabel(fwd.length)"></div>
                            <div class="im-fwd--list" data-bind="template: { name: 'msg-fwd-tpl', foreach: fwd }"></div>
                            <!-- /ko -->
                        </div>
                        <div class="im-mess--tools">
                            <!-- ko if: $data.uuid > 0 -->
                            <a class="im-mess--tool im-mess--tool_reply" data-act="reply" title="{_messenger_reply}"></a>
                            <!-- ko if: sender.id === window.MSG_ME && !attachments.some(a => a.type === 'sticker') -->
                            <a class="im-mess--tool im-mess--tool_edit" data-act="edit" title="{_messenger_edit_message}"></a>
                            <!-- /ko -->
                            <a class="im-mess--tool im-mess--tool_more" data-act="more" title="{_messenger_more}"></a>
                            <!-- /ko -->
                        </div>
                        <div class="im-mess--time" data-bind="html: window.msgTime($data)"></div>
                    </div>
                </div>
                <div class="im-chat--typing" style="display: none; opacity: 0;">
                    <div class="pr pr_gray"><div class="pr_bt"></div><div class="pr_bt"></div><div class="pr_bt"></div></div>
                    {tr('message_user_typing', $peerFirstName)}
                </div>
            </div>
        </div>

        <div class="im-chat--input" data-bind="css: { 'im-chat--input_extra': replyTo() || editMsg() || forwardMsgs().length }">
            {if $canWrite}
                <div class="im-chat-input">
                    <a class="im-chat-input--ava" href="{$thisUser->getURL()}">
                        {include '../components/avatar.latte', author => $thisUser, size => 'miniscule', width => 36, height => 36, alt => $thisUser->getCanonicalName()}
                    </a>
                    <form id="write" class="im-chat-input--form" onsubmit="return false;">
                        <!-- ko if: replyTo() -->
                        <div class="im-chat-input--replied" data-bind="click: () => window.Msg.goToMessage(replyTo().uuid)">
                            <div class="im-chat-input--replied-title">{_messenger_reply_to}</div>
                            <div class="im-chat-input--replied-text"><b data-bind="text: replyTo().sender.name + ':'"></b> <span data-bind="text: window.plainText(replyTo().text) || window.MSG_STR.noText"></span></div>
                            <a class="im-chat-input--replied-close" title="{_cancel}" data-bind="click: () => window.Msg.clearReply(), clickBubble: false"></a>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: editMsg() -->
                        <div class="im-chat-input--replied im-chat-input--replied_edit" data-bind="click: () => window.Msg.goToMessage(editMsg().uuid)">
                            <div class="im-chat-input--replied-title">{_messenger_edit_message}</div>
                            <div class="im-chat-input--replied-text" data-bind="text: window.plainText(editMsg().text) || window.MSG_STR.noText"></div>
                            <a class="im-chat-input--replied-close" title="{_cancel}" data-bind="click: () => window.Msg.cancelEdit(), clickBubble: false"></a>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: forwardMsgs().length -->
                        <div class="im-chat-input--replied">
                            <div class="im-chat-input--replied-title" data-bind="text: window.fwdCountLabel(forwardMsgs().length)"></div>
                            <div class="im-chat-input--replied-text" data-bind="foreach: forwardMsgs()">
                                <div class="im-chat-input--fwd-item"><b data-bind="text: name + ':'"></b> <span data-bind="text: text || window.MSG_STR.noText"></span></div>
                            </div>
                            <a class="im-chat-input--replied-close" title="{_cancel}" data-bind="click: () => window.Msg.clearForward(), clickBubble: false"></a>
                        </div>
                        <!-- /ko -->

                        <input type="hidden" name="horizontal_attachments" value="" autocomplete="off" />
                        <input type="hidden" name="vertical_attachments" value="" autocomplete="off" />
                        <div class="im-chat-input--field">
                            <a class="im-chat-input--attach" id="msgAttachTrigger" title="{_attach}" data-tippy-content-id="msgAttachTooltip" data-tippy-append-to="body" data-tippy-placement="top-start" data-tippy-trigger="click"></a>
                            <textarea
                                class="small-textarea"
                                data-bind="value: messageContent, event: { keydown: onTextareaKeyPress, input: onTextareaInput }"
                                name="message"
                                rows="1"
                                placeholder="{_enter_message}"></textarea>
                            <a class="im-chat-input--smile js-emoji-picker" data-tabs="emoji stickers gifs" title="{_smiles}"></a>
                        </div>
                        <div class="post-horizontal"></div>
                        <div class="post-vertical"></div>

                        <div class="tippy-menu tippy-content-template" id="msgAttachTooltip">
                            <a id="__vkifyPhotoAttachment" class="attach_photo">
                                <div class="post-attach-menu__icon"></div>
                                {_photo}
                            </a>
                            <a id="__vkifyVideoAttachment" class="attach_video">
                                <div class="post-attach-menu__icon"></div>
                                {_video}
                            </a>
                            <a id="__vkifyAudioAttachment" class="attach_audio">
                                <div class="post-attach-menu__icon"></div>
                                {_audio}
                            </a>
                            <a id="__vkifyDocumentAttachment" class="attach_document">
                                <div class="post-attach-menu__icon"></div>
                                {_document}
                            </a>
                            <a id="__vkifyNotesAttachment" class="attach_note">
                                <div class="post-attach-menu__icon"></div>
                                {_note}
                            </a>
                        </div>
                    </form>
                    <button type="button" class="im-chat-input--send" title="{_send}" data-bind="click: sendMessage"></button>
                    <a class="im-chat-input--ava im-chat-input--peer-ava" href="{$isSelf ? $thisUser->getURL() : $correspondent->getURL()}">
                        {if $isSelf}
                            <img src="/assets/packages/static/openvk/img/im/saved_messages.png" class="avatar" width="36" height="36" alt="{_saved_messages}" />
                        {else}
                            {include '../components/avatar.latte', author => $correspondent, size => 'miniscule', width => 36, height => 36, alt => $peerName}
                        {/if}
                    </a>
                </div>
            {else}
                <div class="im-chat--cant-write">{_messages_blocked}</div>
            {/if}
        </div>
    </div>
{/define}
