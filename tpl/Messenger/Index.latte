{extends "../@layout.latte"}

{var $imWide = ($_COOKIE['vkify16_im_wide'] ?? '0') === '1'}
{var $imSide = (int) ($_COOKIE['vkify16_im_side'] ?? 0)}

{block title}{$isArchive ? tr('messenger_archive') : tr('my_messages')}{/block}

{block content}
    <div n:class="im-layout, im-layout_list, $imWide ? im-layout_wide, $imSide > 0 && $imSide < 160 ? im-layout_compact" n:attr="style => $imSide >= 160 ? '--im-side-width: ' . min($imSide, 600) . 'px'">
        <div class="im-layout--side">
            {include "dialogs.latte", corresps => $corresps, dialogSettings => $dialogSettings, isArchive => $isArchive, thisUser => $thisUser, imWide => $imWide}
        </div>
        <div class="im-layout--main im-layout--empty">
            <div class="im-layout--empty-icon"></div>
            <div class="im-layout--empty-text"><vkifyloc name="im_select_dialog"></vkifyloc></div>
        </div>
    </div>
{/block}
