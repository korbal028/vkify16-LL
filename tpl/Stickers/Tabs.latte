{var $items = [
    [
        'url' => '/stickers',
        'title' => 'stickers_store',
        'active' => $act === 'shop'
    ],
    [
        'url' => '/stickers?act=settings',
        'title' => 'stickers_tab_my',
        'active' => $act === 'settings',
        'condition' => isset($thisUser)
    ],
    [
        'url' => '/stickers?act=author',
        'title' => 'stickers_tab_author',
        'active' => $act === 'author',
        'condition' => isset($thisUser) && ($canCreate ?? false)
    ],
    [
        'isSeparator' => true,
        'condition' => isset($thisUser)
    ],
    [
        'url' => '/im',
        'title' => 'stickers_dialogs',
        'condition' => isset($thisUser)
    ]
]}

{include "../components/ui_rmenu.latte", items => $items, id => 'stickers_rmenu', additionalCssClass => 'show_as_menu_on_mobile'}
